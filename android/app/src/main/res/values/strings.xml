    <string name="settings_upscale_off">关闭</string>
    <string name="settings_upscale_xbrz">6 倍 xBRZ</string>
    <string name="settings_upscale_note">对最终画面进行边缘感知平滑处理。可让 2D 精灵和背景更清晰，但无法增加 3D 细节。仅在“软件”或“GPU 1x”渲染器下生效。会占用 GPU 性能。</string>
    <string name="settings_resolution">渲染器与分辨率</string>
    <string name="settings_resolution_software">软件</string>
    <string name="settings_resolution_gpu_1x">GPU 1x</string>
    <string name="settings_resolution_gpu_2x">GPU 2x</string>
    <string name="settings_resolution_gpu_3x">GPU 3x</string>
    <string name="settings_resolution_gpu_4x">GPU 4x</string>
    <string name="settings_resolution_gpu_6x">GPU 6x</string>
    <string name="settings_resolution_gpu_8x">GPU 8x</string>
    <string name="settings_resolution_note">GPU 渲染器使用 Vulkan，可以更高的内部分辨率渲染，使 3D 多边形和精灵更清晰。分辨率越高，对 GPU 和内存的要求越高：6x 约需 0.8 GB，8x 约需 1.4 GB，仅适合高端设备。如果设备无法运行，会自动降低分辨率或回退到软件渲染器。软件渲染器的精确度最高。</string>
    <string name="settings_graphics_enhancements">画面增强</string>
